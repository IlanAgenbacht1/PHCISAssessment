@page "/appointments"
@attribute [Authorize(Roles = Roles.Patient)]
@inject IBookingApi Api

<PageTitle>My appointments | PHCIS Booking</PageTitle>

<div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">My appointments</MudText>
    <MudButton Href="" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Book</MudButton>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_appointments is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTabs Elevation="0" Outlined="true" TabPanelsClass="pt-4">
        <MudTabPanel Text="@($"Upcoming ({_upcoming.Count})")">
            @if (_upcoming.Count == 0)
            {
                <MudText>Nothing booked. <MudLink Href="">Find a time</MudLink></MudText>
            }
            @foreach (var appointment in _upcoming)
            {
                <AppointmentCard Appointment="appointment" @key="appointment.Id" />
            }
        </MudTabPanel>
        <MudTabPanel Text="Past and cancelled">
            @if (_history.Count == 0)
            {
                <MudText>No past appointments yet.</MudText>
            }
            @foreach (var appointment in _history)
            {
                <AppointmentCard Appointment="appointment" @key="appointment.Id" />
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    private List<AppointmentDto>? _appointments;
    private List<AppointmentDto> _upcoming = [];
    private List<AppointmentDto> _history = [];
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetMyAppointmentsAsync();
        if (!result.Succeeded)
        {
            _error = result.Error!.Message;
            return;
        }

        _appointments = result.Value;
        // The API decides what's still changeable; the client doesn't second-guess it with its own clock.
        _upcoming = _appointments.Where(a => a.CanBeChanged).OrderBy(a => a.Start).ToList();
        _history = _appointments.Except(_upcoming).ToList();
    }
}
